# Home Assistant connection (injected at Docker build time for production)
VITE_HA_URL=http://homeassistant.local:8123
VITE_HA_TOKEN=your-long-lived-access-token

# Optional RSS proxy for playroom spotlight feeds (same-origin or CORS-enabled endpoint).
# Example: https://your-proxy.example/rss?url=
# VITE_RSS_PROXY=

# Used by validate-entities script (CI)
HA_URL=http://homeassistant.local:8123
HA_TOKEN=your-long-lived-access-token
